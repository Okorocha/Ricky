modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Ricky Dashboard"

[[workflows.workflow]]
name = "Ricky Dashboard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "export PORT=18717 BASE_PATH=/ && pnpm --filter @workspace/ricky run dev"
waitForPort = 18717

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

